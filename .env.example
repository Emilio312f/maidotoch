# Configuración de MaidoTouch (Diseño v1.1: un proceso por servicio). Copiar a .env (no se sube al
# repositorio) y completar. Ningún valor real va en este archivo.
# En el servidor, ops/preparar-servidor.sh genera /etc/maidotouch/comun.env y adaptador-ia.env.

# Base SQLite con el esquema de seguridad alimentaria (se respalda antes de cada migración).
MAIDOTOUCH_DB_PATH=maidotouch.db
MAIDOTOUCH_MIGRACIONES_DIR=db/migrations
# URL pública HTTPS de la web-app; con ella se generan los enlaces de los tags NFC y los QR.
MAIDOTOUCH_URL_PUBLICA=https://maidotouch.example
# Fotos de la carta subidas desde el back-office (Servicio de Catálogo, se sirven en /fotos/).
MAIDOTOUCH_FOTOS_DIR=fotos
# Web-apps compiladas que entrega el API Gateway (comensal en /, back-office en /admin).
MAIDOTOUCH_WEB_COMENSAL_DIR=frontend/dist/comensal
MAIDOTOUCH_WEB_BACKOFFICE_DIR=frontend/dist/backoffice

# Dirección de cada servicio. Por defecto http://127.0.0.1:<puerto>; con https:// usan el TLS interno.
# MAIDOTOUCH_URL_GATEWAY=http://127.0.0.1:8080
# MAIDOTOUCH_URL_SESION=http://127.0.0.1:8101
# MAIDOTOUCH_URL_CATALOGO=http://127.0.0.1:8102
# MAIDOTOUCH_URL_SEGURIDAD_ALIMENTARIA=http://127.0.0.1:8103
# MAIDOTOUCH_URL_RECOMENDACION=http://127.0.0.1:8104
# MAIDOTOUCH_URL_ADAPTADOR_IA=http://127.0.0.1:8105
# MAIDOTOUCH_URL_PEDIDO=http://127.0.0.1:8106
# MAIDOTOUCH_URL_ATENCION=http://127.0.0.1:8107
# MAIDOTOUCH_URL_TRAZABILIDAD=http://127.0.0.1:8108
# MAIDOTOUCH_URL_PILOTO=http://127.0.0.1:8109
# MAIDOTOUCH_URL_BUS=http://127.0.0.1:8110

# Token de servicio de cada uno (mínimo 32 caracteres). Generar con:
#   maidotouch-herramientas tokens     (en desarrollo, scripts/desarrollo.sh los crea en .env.servicios)
MAIDOTOUCH_TOKEN_GATEWAY=
MAIDOTOUCH_TOKEN_SESION=
MAIDOTOUCH_TOKEN_CATALOGO=
MAIDOTOUCH_TOKEN_SEGURIDAD_ALIMENTARIA=
MAIDOTOUCH_TOKEN_RECOMENDACION=
MAIDOTOUCH_TOKEN_ADAPTADOR_IA=
MAIDOTOUCH_TOKEN_PEDIDO=
MAIDOTOUCH_TOKEN_ATENCION=
MAIDOTOUCH_TOKEN_TRAZABILIDAD=
MAIDOTOUCH_TOKEN_PILOTO=
MAIDOTOUCH_TOKEN_BUS=

# TLS entre servicios (almacén PKCS12 con alias "maidotouch"); vacío en desarrollo.
MAIDOTOUCH_TLS_ALMACEN=
MAIDOTOUCH_TLS_CLAVE=

# Proveedor de IA (Claude, de Anthropic): solo en el entorno del Servicio Adaptador de IA.
# Sin clave, el asistente usa solo el ranking por reglas.
ANTHROPIC_API_KEY=
MAIDOTOUCH_IA_MODELO=claude-opus-5-5
# Tiempo máximo de espera al proveedor antes del fallback (RNF04): 5 s.
MAIDOTOUCH_IA_TIMEOUT_MS=5000
# Consultas con IA por sesión de comensal (RP05); lo aplica el Servicio de Recomendación.
MAIDOTOUCH_IA_LIMITE_CONSULTAS=10
MAIDOTOUCH_RECOMENDACIONES_MAX=3

# Límite de solicitudes del API Gateway por minuto.
MAIDOTOUCH_LIMITE_IP_MINUTO=600
MAIDOTOUCH_LIMITE_SESION_MINUTO=120

# Horas tras las que se cierra una sesión de comensal y se descarta su perfil (RNF02).
MAIDOTOUCH_SESION_HORAS=6
MAIDOTOUCH_PERSONAL_SESION_HORAS=12

# Solo para comandos de consola (crear-personal, cambiar-clave, demo); no dejarla definida en el servidor.
MAIDOTOUCH_CLAVE=
