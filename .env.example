# Configuración de MaidoTouch. Copiar a .env (no se sube al repositorio) y completar.
# Ningún valor real va en este archivo.

# Archivo SQLite del servidor (se respalda automáticamente antes de cada migración).
MAIDOTOUCH_DB_PATH=maidotouch.db
MAIDOTOUCH_PUERTO=8080
# URL pública HTTPS de la web-app; con ella se generan los enlaces de los tags NFC y los QR.
MAIDOTOUCH_URL_PUBLICA=https://maidotouch.example
MAIDOTOUCH_FRONTEND_DIR=frontend/dist
MAIDOTOUCH_MIGRACIONES_DIR=db/migrations
# Fotos de la carta subidas desde el back-office (se sirven en /fotos/).
MAIDOTOUCH_FOTOS_DIR=fotos

# Proveedor de IA (Claude, de Anthropic). Sin clave, el asistente usa solo el ranking por reglas.
ANTHROPIC_API_KEY=
MAIDOTOUCH_IA_MODELO=claude-opus-5-5
# Tiempo máximo de espera al proveedor antes del fallback (RNF04): 5 s.
MAIDOTOUCH_IA_TIMEOUT_MS=5000
# Consultas con IA por sesión de comensal (RP05).
MAIDOTOUCH_IA_LIMITE_CONSULTAS=10
MAIDOTOUCH_RECOMENDACIONES_MAX=3

# Horas tras las que se cierra una sesión de comensal y se descarta su perfil (RNF02).
MAIDOTOUCH_SESION_HORAS=6
MAIDOTOUCH_PERSONAL_SESION_HORAS=12

# Solo para comandos de consola (crear-personal, cambiar-clave, demo); no dejarla definida en el servidor.
MAIDOTOUCH_CLAVE=
