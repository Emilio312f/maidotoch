# /etc/systemd/system/maidotouch.service
[Unit]
Description=MaidoTouch (API y web-app)
After=network-online.target
Wants=network-online.target

[Service]
User=maidotouch
Group=maidotouch
WorkingDirectory=/opt/maidotouch/actual
# Variables de .env.example con valores reales; el archivo solo lo lee root y maidotouch.
EnvironmentFile=/etc/maidotouch/maidotouch.env
Environment=MAIDOTOUCH_DB_PATH=/opt/maidotouch/datos/maidotouch.db
Environment=MAIDOTOUCH_FRONTEND_DIR=/opt/maidotouch/actual/web
Environment=MAIDOTOUCH_MIGRACIONES_DIR=/opt/maidotouch/actual/migraciones
# Fotos de la carta: fuera de las versiones, para que sobrevivan a cada despliegue.
Environment=MAIDOTOUCH_FOTOS_DIR=/opt/maidotouch/datos/fotos
ExecStart=/opt/maidotouch/actual/bin/maidotouch servir
# Disponibilidad durante el servicio (RNF05): si el proceso cae, systemd lo levanta.
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maidotouch/datos

[Install]
WantedBy=multi-user.target
