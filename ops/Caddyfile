# /etc/caddy/Caddyfile — HTTPS con certificado automático delante de MaidoTouch.
# Reemplazar los dominios por los reales de staging y producción.

maidotouch.example {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# El enlace del tag lleva el token del puesto: no se envía como referer a otros sitios.
		Referrer-Policy "no-referrer"
		-Server
	}

	# Recursos de la web-app con nombre versionado: se pueden guardar en caché mucho tiempo.
	@versionados path /assets/* /admin/assets/* /fotos/*
	header @versionados Cache-Control "public, max-age=31536000, immutable"

	# API Gateway: único punto de entrada; los demás servicios escuchan solo en 127.0.0.1 con TLS interno.
	# flush_interval -1: el bus de eventos (Server-Sent Events) llega sin demora a las pantallas.
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
