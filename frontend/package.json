{
  "name": "maidotouch-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.comensal.config.ts",
    "dev:backoffice": "vite --config vite.backoffice.config.ts",
    "build": "tsc --noEmit && npm run build:comensal && npm run build:backoffice",
    "build:comensal": "vite build --config vite.comensal.config.ts",
    "build:backoffice": "vite build --config vite.backoffice.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
